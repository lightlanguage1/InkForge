# InkForge API 密钥配置
# 复制此文件为 .env，填入你的 API Key
# 至少配置一个后端即可使用

# ---- DeepSeek Key Pool (推荐，轮询分配) ----
# 多个 Key 用逗号分隔，自动轮询分配
INKFORGE_API_KEYS=sk-key1,sk-key2,sk-key3

# ---- 单 Key 模式 ----
# INKFORGE_API_KEY=sk-your-key-here
# DEEPSEEK_API_KEY=sk-your-key-here

# ---- OpenAI ----
# OPENAI_API_KEY=sk-your-key-here

# ---- Anthropic Claude ----
# CLAUDE_API_KEY=sk-ant-your-key-here

# ---- Google Gemini ----
# GEMINI_API_KEY=your-key-here

# ---- Ollama 本地模型 (无需 API Key) ----
# OLLAMA_BASE_URL=http://localhost:11434

# ---- 本地 llama-server (无需 API Key) ----
# LOCAL_LLM_URL=http://127.0.0.1:8080/v1
