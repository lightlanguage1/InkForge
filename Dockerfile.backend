FROM python:3.12-slim

WORKDIR /app

# Pip mirror — override via build-arg for constrained networks
ARG PIP_INDEX=https://pypi.org/simple/
ARG PIP_TRUSTED_HOST=""
ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}

# Install Python dependencies
COPY requirements.txt .
RUN if [ -n "$PIP_TRUSTED_HOST" ]; then \
        pip install --no-cache-dir -r requirements.txt \
            -i "$PIP_INDEX" --trusted-host "$PIP_TRUSTED_HOST"; \
    else \
        pip install --no-cache-dir -r requirements.txt; \
    fi

# Copy application
COPY novel_agent/ novel_agent/

# Allow Python to find the package without pip install
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

RUN mkdir -p /app/work

# Pre-download ChromaDB embedding model — baked into image, survives rebuilds
RUN python3 -c "from chromadb.utils.embedding_functions import DefaultEmbeddingFunction; \
    DefaultEmbeddingFunction(); print('Embedding model cached')"

EXPOSE 8000

CMD ["uvicorn", "novel_agent.api.server:app", "--host", "0.0.0.0", "--port", "8000"]
