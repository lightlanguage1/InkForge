FROM python:3.12-slim

WORKDIR /app

# Pip mirror — override via build-arg for constrained networks
ARG PIP_INDEX=https://pypi.org/simple/
ARG PIP_TRUSTED_HOST=""

# Install Python dependencies
COPY requirements.txt .
RUN if [ -n "$PIP_TRUSTED_HOST" ]; then \
        pip install --no-cache-dir -r requirements.txt \
            -i "$PIP_INDEX" --trusted-host "$PIP_TRUSTED_HOST"; \
    else \
        pip install --no-cache-dir -r requirements.txt; \
    fi

# Copy application
COPY novel_agent/ novel_agent/

# Allow Python to find the package without pip install
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

RUN mkdir -p /app/work

# Pre-download ChromaDB embedding model (avoids 80s first-gen delay)
RUN python3 -c "import chromadb; chromadb.Client().get_or_create_collection('_warmup')"

EXPOSE 8000

CMD ["uvicorn", "novel_agent.api.server:app", "--host", "0.0.0.0", "--port", "8000"]
