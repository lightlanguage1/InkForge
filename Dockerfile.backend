FROM python:3.12-slim

WORKDIR /app

# Pip mirror — override via build-arg for constrained networks
ARG PIP_INDEX=https://pypi.org/simple/
ARG PIP_TRUSTED_HOST=""
ARG HTTP_PROXY=""
ARG HTTPS_PROXY=""
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}

# Install system deps + nginx (no proxy — use Debian mirror directly)
RUN unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy && \
    apt-get update && apt-get install -y --no-install-recommends nginx && \
    rm -rf /var/lib/apt/lists/*

# ── ChromaDB model — early layer, survives all code/req changes ──
RUN pip install --no-cache-dir chromadb && \
    python3 -c "from chromadb.utils.embedding_functions import DefaultEmbeddingFunction; DefaultEmbeddingFunction()" && \
    echo "ChromaDB model cached"

# Install Python dependencies
COPY requirements.txt .
RUN if [ -n "$PIP_TRUSTED_HOST" ]; then \
        pip install --no-cache-dir -r requirements.txt \
            -i "$PIP_INDEX" --trusted-host "$PIP_TRUSTED_HOST"; \
    else \
        pip install --no-cache-dir -r requirements.txt; \
    fi

# Copy application
COPY novel_agent/ novel_agent/

# Allow Python to find the package without pip install
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

RUN mkdir -p /app/work

# Nginx reverse proxy config
RUN rm -f /etc/nginx/sites-enabled/default
COPY docker/nginx-backend.conf /etc/nginx/conf.d/default.conf

# Entrypoint: start nginx + uvicorn together
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000
CMD ["/entrypoint.sh"]
