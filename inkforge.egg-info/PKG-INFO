│   ├── cli/                   # 命令行界面
│   │   ├── main.py                    # 全部命令注册
│   │   ├── project.py                 # 项目创建/查找
│   │   ├── foundation.py              # 故事设定向导
│   │   ├── recent_projects.py         # 最近项目追踪
│   │   └── commands/                  # 各命令实现
│   │       ├── skill.py               # 技能管理
│   │       ├── plot.py                # 情节节拍管理
